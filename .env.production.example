# Compose reads this file with --env-file .env.production.
COD_IMAGE=ghcr.io/tel-u-dormitory/class-of-dormitory:sha-REPLACE_WITH_FULL_COMMIT_SHA
APP_PORT=8080
APP_NAME="Clash of Dormitory"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://cod.example.com
APP_TIMEZONE=Asia/Jakarta
APP_LOCALE=id
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=id_ID
APP_MAINTENANCE_DRIVER=file
# Comma-separated proxy IPs/CIDRs as seen from the container; see deployment guide.
TRUSTED_PROXIES=
LOG_CHANNEL=stderr
LOG_LEVEL=warning
DB_CONNECTION=mysql
# Use mysql only with compose.mysql.yaml. Otherwise set the real database host.
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=cod_s3
DB_USERNAME=cod
DB_PASSWORD=
# Only used for a NEW MySQL service in compose.mysql.yaml.
MYSQL_ROOT_PASSWORD=
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_SECURE_COOKIE=true
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax
FILESYSTEM_DISK=public
CACHE_STORE=database
# No queued application jobs currently; add a worker before changing this.
QUEUE_CONNECTION=sync
INERTIA_SSR_ENABLED=false
# Set SMTP credentials if password reset/email delivery is needed.
MAIL_MAILER=log
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=no-reply@example.com
MAIL_FROM_NAME="${APP_NAME}"
EXAM_GRACE_SECONDS=3
EXAM_LATE_SUBMIT_SECONDS=300
EXAM_LATE_SKEW_SECONDS=5
