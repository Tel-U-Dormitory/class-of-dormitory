# Shared Resora MySQL profile. Apply during maintenance; preserve the data volume.
[mysqld]
performance_schema=OFF
mysqlx=OFF
innodb_buffer_pool_size=64M
max_connections=24
thread_cache_size=4
table_open_cache=256
table_definition_cache=400
tmp_table_size=8M
max_heap_table_size=8M
# Preserve durable commits; do not disable redo/binlog flushing for performance.
innodb_flush_log_at_trx_commit=1
